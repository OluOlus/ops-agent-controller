{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "8001ccf9-a80b-4a46-bc07-1da3a25780de",
  "developer": {
    "name": "Limesoft",
    "websiteUrl": "https://github.com/OluOlus/ops-agent-controller",
    "privacyUrl": "https://github.com/OluOlus/ops-agent-controller",
    "termsOfUseUrl": "https://github.com/OluOlus/ops-agent-controller"
  },
  "name": {
    "short": "OpsAgent AWS",
    "full": "OpsAgent AWS Operations Assistant"
  },
  "description": {
    "short": "AWS incident diagnosis and remediation",
    "full": "Conversational Tier-1 Ops assistant for AWS. Diagnose EC2 issues, check CloudWatch metrics, reboot instances with approval, and manage incidents from Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#FF9900",
  "bots": [
    {
      "botId": "8001ccf9-a80b-4a46-bc07-1da3a25780de",
      "scopes": ["personal", "team", "groupChat"],
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "health", "description": "Check system status" },
            { "title": "help", "description": "Show available commands" },
            { "title": "describe instance", "description": "Get EC2 instance details" },
            { "title": "cpu metrics", "description": "View CPU metrics" },
            { "title": "reboot instance", "description": "Reboot EC2 (requires approval)" }
          ]
        }
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "c6kpu67v33.execute-api.eu-west-2.amazonaws.com"
  ]
}
