            { "title": "cpu metrics", "description": "View CPU metrics for an instance" },
            { "title": "reboot instance", "description": "Reboot an EC2 instance (requires approval)" }
          ]
        }
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
